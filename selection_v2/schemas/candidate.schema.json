{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 3 candidate (doc 6.5)",
  "type": "object",
  "required": ["id", "scene_id", "type", "variant", "start", "end", "segments", "raw_duration", "final_duration",
               "beats_included", "reaction", "removed", "context_required", "register", "dynamic", "eligible_for_final"],
  "properties": {
    "id": {"type": "string", "pattern": "^C[0-9]+[a-z]+$"},
    "scene_id": {"type": "integer"},
    "type": {"type": "string", "enum": ["comedy", "emotional", "hook", "loop"]},
    "variant": {"type": "string", "enum": ["full_arc", "full_arc_trimmed", "tight", "tight_trimmed", "cold_open", "cold_open_trimmed",
                                           "full", "full_trimmed", "peak", "peak_trimmed", "one", "one_trimmed", "one_before", "one_before_trimmed",
                                           "one_early", "one_early_trimmed", "one_before_early", "one_before_early_trimmed", "extended", "extended_untrimmed",
                                           "open_question", "open_question_trimmed", "thread", "critic_trimmed", "scene", "scene_trimmed",
                                           "situation", "situation_trimmed", "teaser_open", "channel_short"]},
    "trim_level": {"type": "string", "enum": ["none", "stretches", "lines"]},
    "start": {"type": "number", "minimum": 0},
    "end": {"type": "number", "minimum": 0},
    "segments": {"type": "array", "minItems": 1,
                 "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}}},
    "raw_duration": {"type": "number", "minimum": 0},
    "final_duration": {"type": "number", "minimum": 0},
    "beats_included": {"type": "array", "items": {"type": "string", "pattern": "^L[0-9]{4}$"}},
    "payoff_line": {"type": "string"},
    "anchor_line": {"type": "string"},
    "reaction": {"type": ["string", "null"]},
    "reaction_type": {"type": ["string", "null"]},
    "removed": {"type": "object", "required": ["gaps_shortened", "gaps_removed", "lines_skipped"],
                "properties": {
                  "gaps_shortened": {"type": "array", "items": {"type": "object", "required": ["range", "to_s", "cut_at"],
                                     "properties": {"range": {"type": "string"}, "to_s": {"type": "number"}, "cut_at": {"type": "number"},
                                                    "cut_quality": {"type": "string"}, "kind": {"type": ["string", "null"]}}}},
                  "gaps_removed": {"type": "array", "items": {"type": "object", "required": ["range"]}},
                  "lines_skipped": {"type": "array", "items": {"type": "string", "pattern": "^L[0-9]{4}$"}}}},
    "extra_lines": {"type": "object", "properties": {"start": {"type": "array", "items": {"type": "string"}},
                                                     "end": {"type": "array", "items": {"type": "string"}}}},
    "end_note": {"type": "string"},
    "context_required": {"type": "array", "items": {"type": "string"}},
    "register": {"type": ["string", "null"]},
    "dynamic": {"type": "object"},
    "callbacks": {"type": "array"},
    "flags": {"type": "object", "properties": {"over_platform_max": {"type": "boolean", "description": "final_duration exceeds stage3.platform_max_s; the candidate stays in the pool (untrimmed arcs are always generated) but is NOT eligible for Stage 6"}}},
    "eligible_for_final": {"type": "boolean", "description": "false when over the platform maximum: Stage 4/5 may score it, Stage 6 must never select it (founder, 2026-10-27)"},
    "start_note": {"type": ["string", "null"]},
    "untrimmed_sibling": {"type": ["string", "null"], "description": "id of this trimmed candidate's untrimmed version of the same moment (founder, 2026-10-27: Stage 6 outputs both, each with its own Stage 5 verdict)"},
    "trimmed_sibling": {"type": ["string", "null"], "description": "id of this untrimmed candidate's trimmed version, when one was kept"},
    "end_sibling": {"type": ["string", "null"], "description": "legacy hooks (before 2026-10-29): the same start with the other end"},
    "button_line": {"type": "string", "description": "founder, 2026-10-29: the spoken reaction / exit line the clip ends after (sheet button_line or the button rule)"},
    "critic_trim_of": {"type": "string", "description": "critic_trimmed: the id of the variant whose pace-flagged stretches this one shortens"},
    "thread": {"type": "object", "description": "thread candidates: setup scene and lines, payoff scene, end line, why"},
    "wider_sibling": {"type": ["string", "null"], "description": "hooks / loops: the same end opening one beat earlier (the sibling Stage 4 widens to on removed_needed)"},
    "target_s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "length_vs_target": {"type": "string", "enum": ["under", "in", "sketch", "over"]},
    "lines": {"type": "array", "items": {"type": "string"}},
    "n_lines": {"type": "integer"},
    "note": {"type": "string"},
    "start_str": {"type": "string"},
    "end_str": {"type": "string"},
    "also": {"type": "array"}
  }
}
