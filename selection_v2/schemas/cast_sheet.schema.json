{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cast_sheet",
  "type": "object",
  "required": ["frames", "characters"],
  "properties": {
    "frames": {"type": "array", "items": {"type": "object",
      "required": ["frame_id", "n_people_visible", "visible_keys", "named_visible", "named_identifiable", "note"],
      "properties": {"frame_id": {"type": "string"}, "n_people_visible": {"type": "integer", "minimum": 0},
                     "visible_keys": {"type": "array", "items": {"type": "string"}}, "named_visible": {"type": "boolean"},
                     "named_identifiable": {"type": "boolean"}, "note": {"type": "string"}}}},
    "characters": {"type": "array", "items": {"type": "object", "required": ["key", "look", "best_frames", "confidence"],
      "properties": {"key": {"type": "string"}, "look": {"type": "string"}, "look_changes": {"type": "string"},
                     "best_frames": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}}
  }
}
