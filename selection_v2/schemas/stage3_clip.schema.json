{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stage3_clips",
  "description": "founder, 2026-11-04 (option B): Stage 3b, one call per scene shapes its moments into clips while watching the scene",
  "type": "object",
  "required": [
    "left_out",
    "clips"
  ],
  "properties": {
    "left_out": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "moment",
          "why"
        ],
        "properties": {
          "moment": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "moments",
          "works",
          "why_not",
          "start",
          "end",
          "drops",
          "cold_open",
          "hook",
          "title",
          "why",
          "kind",
          "spoiler"
        ],
        "properties": {
          "moments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "works": {
            "type": "boolean"
          },
          "why_not": {
            "type": "string"
          },
          "start": {
            "type": "object",
            "required": [
              "line",
              "at"
            ],
            "properties": {
              "line": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "description": "the word copied exactly from the line"
              }
            }
          },
          "end": {
            "type": "object",
            "required": [
              "line",
              "at"
            ],
            "properties": {
              "line": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "description": "the word copied exactly from the line"
              }
            }
          },
          "drops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "first",
                "last",
                "why"
              ],
              "properties": {
                "first": {
                  "type": "string"
                },
                "last": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "cold_open": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "line",
              "why"
            ],
            "properties": {
              "line": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            }
          },
          "hook": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "standalone",
              "promo"
            ]
          },
          "spoiler": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
