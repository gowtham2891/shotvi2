 "sentences": [
  {
   "id": 0,
   "text": "మేము Svalbard అనే island నుంచి North Pole కి వెళ్లి land అవ్వాలి.",
   "start": 0.06,
   "end": 3.74,
   "speaker": "speaker_0",
   "words": [
    0,
    10
   ]
  },
  {
   "id": 1,
   "text": "ఈ Svalbard లో wait చేస్తున్నాం.",
   "start": 3.82,
   "end": 5.24,
   "speaker": "speaker_0",
   "words": [
    11,
    15
   ]
  },
  {
   "id": 2,
   "text": "ఎంతండి?",
