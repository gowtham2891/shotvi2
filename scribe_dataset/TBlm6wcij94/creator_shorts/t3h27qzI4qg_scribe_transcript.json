 "language_probability": 0.9987049698829651,
 "sentences": [
  {
   "id": 0,
   "text": "Ego lifting",
   "start": 0.18,
   "end": 0.76,
   "speaker": "speaker_0",
   "words": [
    0,
    1
   ]
  },
  {
   "id": 1,
   "text": "అర్థం చేసుకోవాల్సింది ఏంటంటే, నీ నడ్డి విరిగితే అమ్మాయి అయితే రాదు నీకు సేవలు చేయడానికి.",
   "start": 0.92,
   "end": 4.44,
   "speaker": "speaker_1",
   "words": [
    2,
    13
   ]
  },
  {
   "id": 2,
   "text": "పవిత్ర బంధం.",
   "start": 6.0,
   "end": 6.56,
   "speaker": "speaker_0",
   "words": [
    14,
    15
   ]
  },
  {
   "id": 3,
   "text": "పవిత్ర బంధం లాంటి సీన్లు ఇప్పుడు జరగట్లేదు నాన్న.",
   "start": 6.68,
   "end": 9.06,
   "speaker": "speaker_1",
   "words": [
    16,
    22
   ]
  },
  {
   "id": 4,
   "text": "Ego lifting కి వెళ్తారన్నమాట.",
   "start": 10.18,
   "end": 11.28,
   "speaker": "speaker_0",
   "words": [
    23,
    26
   ]
  },
  {
   "id": 5,
   "text": "అమ్మాయి కనపడగానే కొంచెం హుషారు వచ్చేసి ప్లేట్లు పెంచడం, లేపేయడం.",
   "start": 11.34,
   "end": 14.02,
   "speaker": "speaker_0",
   "words": [
    27,
    34
   ]
  },
  {
   "id": 6,
   "text": "అవును.",
   "start": 14.26,
   "end": 14.6,
   "speaker": "speaker_1",
   "words": [
    35,
    35
   ]
  },
  {
   "id": 7,
   "text": "వాళ్ళ capacity కంటే ఎక్కువ లేపేయాలి weights అన్న వెళ్ళిపోతారు.",
   "start": 14.64,
   "end": 18.14,
   "speaker": "speaker_0",
   "words": [
    36,
    43
   ]
  },
  {
   "id": 8,
   "text": "అది ఎంతవరకు కరెక్ట్?",
   "start": 18.46,
   "end": 19.44,
   "speaker": "speaker_0",
   "words": [
    44,
    46
   ]
  },
  {
   "id": 9,
   "text": "Injury is fundamentally technically speaking or mechanistically speaking మన joint ఇది range of motion.",
   "start": 19.56,
   "end": 25.22,
   "speaker": "speaker_1",
   "words": [
    47,
    60
   ]
  },
  {
   "id": 10,
   "text": "ఉమ్",
   "start": 25.4,
   "end": 25.62,
   "speaker": "speaker_0",
   "words": [
    61,
    61
   ]
  },
  {
   "id": 11,
   "text": "అంటే ఏంటి మీ weight increase చేస్తూ increase చేస్తూ increase చేస్తూ అనే కొద్ది, దీని capacity ఎంతుందో అంతేగా తీసుకోగలుగుతుంది.",
   "start": 25.96,
   "end": 31.42,
   "speaker": "speaker_1",
   "words": [
    62,
    78
   ]
  },
  {
   "id": 12,
   "text": "దాని capacity ని మించి నువ్వు చేస్తున్నప్పుడే ఒక point of time లో అది give up ఇస్తుంది.",
   "start": 31.46,
   "end": 35.28,
   "speaker": "speaker_1",
   "words": [
    79,
    93
   ]
  },
  {
   "id": 13,
   "text": "That is what injury is.",
   "start": 35.44,
   "end": 36.28,
   "speaker": "speaker_1",
   "words": [
    94,
    98
   ]
  },
  {
   "id": 14,
   "text": "సో, ఇప్పుడు నువ్వు shoulder press చేస్తున్నావు.",
   "start": 36.72,
   "end": 37.82,
   "speaker": "speaker_1",
   "words": [
    99,
    104
   ]
  },
  {
   "id": 15,
   "text": "నాకు ఇంత shoulder ఉంది.",
   "start": 37.86,
   "end": 38.62,
   "speaker": "speaker_1",
   "words": [
    105,
    108
   ]
  },
  {
   "id": 16,
   "text": "ఉమ్",
   "start": 38.7,
   "end": 38.8,
   "speaker": "speaker_0",
   "words": [
    109,
    109
   ]
  },
  {
   "id": 17,
   "text": "ఇంత shoulder ఉంది కదా అని చెప్పి నా capacity నేను అర్థం చేసుకోకుండా push చేస్తున్నాను అంటే, నేను ఎంత right form లో చేసినా నాకు ఇంక injury అవుతుంది.",
   "start": 39.12,
   "end": 45.22,
   "speaker": "speaker_1",
   "words": [
    110,
    133
   ]
  },
  {
   "id": 18,
   "text": "నేను ఒకటే చెప్తా ఎవ్వరికైనా సరే, నీ ego ని జిమ్ బయట వదిలేసి లోపల రా.",
   "start": 45.28,
   "end": 47.82,
   "speaker": "speaker_1",
   "words": [
    134,
    146
   ]
  },
  {
   "id": 19,
   "text": "పైసాకి పనికిరదు నీ ego.",
   "start": 48.08,
   "end": 49.28,
   "speaker": "speaker_1",
   "words": [
    147,
    150
   ]
  },
  {
   "id": 20,
   "text": "ఎందుకంటే ఒక్క injury అయిందంటే మీ జీవితం మొత్తం తారుమారు అయిపోతుంది.",
   "start": 49.54,
   "end": 53.48,
   "speaker": "speaker_1",
   "words": [
    151,
    159
   ]
  },
  {
   "id": 21,
   "text": "రెండు వందల కేజీలు ఎత్తాల్సిన అవసరం ఏంటి నాకు?",
   "start": 53.72,
   "end": 55.62,
   "speaker": "speaker_1",
   "words": [
    160,
    166
   ]
  },
  {
   "id": 22,
   "text": "అంటే నా ego నేను boost చేసుకోవడానికే కదా చేస్తున్నాను.",
   "start": 55.68,
   "end": 57.82,
   "speaker": "speaker_1",
   "words": [
    167,
    174
   ]
  },
  {
   "id": 23,
   "text": "అంటే maximum ఇప్పుడు నేను కింద పడేయని బస్తా ఒక పదిహేను కేజీల బస్తా ఎత్తుతా నేను.",
   "start": 58.26,
   "end": 61.82,
   "speaker": "speaker_1",
   "words": [
    175,
    187
   ]
  },
  {
   "id": 24,
   "text": "లేదు ఒక ఇటు ఒక పదిహేను కేజీలు, అటు ఒక పదిహేను కేజీలు ఏదో మోయ్యాలి.",
   "start": 62.02,
   "end": 64.66,
   "speaker": "speaker_1",
   "words": [
    188,
    199
   ]
  },
  {
   "id": 25,
   "text": "అది మోయగలిగితే చాలు కదా నేను.",
   "start": 64.86,
   "end": 66.02,
   "speaker": "speaker_1",
   "words": [
    200,
    204
   ]
  },
  {
   "id": 26,
   "text": "So every time I am increasing weight on the bar and the heavier I am going the chances of getting injured are increasing.",
   "start": 66.28,
   "end": 72.18,
   "speaker": "speaker_1",
   "words": [
    205,
    227
   ]
  },
  {
   "id": 27,
   "text": "Injury అయిపోతుంది అని కాదు.",
   "start": 72.48,
   "end": 73.6,
   "speaker": "speaker_1",
   "words": [
    228,
    231
   ]
  },
  {
   "id": 28,
   "text": "Injury అయ్యే chances ని పెంచుకుంటున్నాను.",
   "start": 74.18,
   "end": 75.86,
   "speaker": "speaker_1",
   "words": [
    232,
    236
   ]
  },
  {
   "id": 29,
   "text": "దాని వల్ల ఏమవుతుంది?",
   "start": 75.98,
   "end": 76.92,
   "speaker": "speaker_1",
   "words": [
    237,
    239
   ]
  },
  {
   "id": 30,
   "text": "One bad day, one bad rep, one injury is taking me back three, four years.",
   "start": 77.24,
   "end": 81.7,
   "speaker": "speaker_1",
   "words": [
    240,
    254
   ]
  }
 ],
