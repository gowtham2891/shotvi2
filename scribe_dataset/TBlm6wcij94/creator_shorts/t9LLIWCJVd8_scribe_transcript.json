   "speaker": "speaker_1",
   "words": [
    186,
    190
   ]
  },
  {
   "id": 18,
   "text": "Eleven thirty కో meal తింటా, one thirty two కో meal తింటా, six thirty seven కల్లా ఒక meal తింటా.",
   "start": 67.04,
