   "end": 67.6,
   "speaker": "speaker_0",
   "words": [
    212,
    216
   ]
  },
  {
   "id": 29,
   "text": "చక్కగా నాకు నచ్చింది తింటాను.",
   "start": 67.92,
   "end": 69.12,
   "speaker": "speaker_0",
   "words": [
    217,
    220
   ]
  },
  {
   "id": 30,
