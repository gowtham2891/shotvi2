 "sentences": [
  {
   "id": 0,
   "text": "నెల్లూరు అనుకుంటాను.",
   "start": 0.18,
   "end": 1.0,
   "speaker": "speaker_0",
   "words": [
    0,
    1
   ]
  },
  {
   "id": 1,
   "text": "హోటల్ నుంచి కార్ కి రావాలి నేను.",
   "start": 1.16,
   "end": 3.08,
   "speaker": "speaker_0",
   "words": [
    2,
    7
   ]
  },
  {
   "id": 2,
   "text": "జనాభా అంతా ఉన్నారంటే యు కాంట్ ఈవెన్ కంట్రోల్.",
   "start": 3.48,
   "end": 6.54,
   "speaker": "speaker_0",
   "words": [
    8,
    14
   ]
  },
  {
   "id": 3,
   "text": "ఉమ్",
   "start": 6.78,
   "end": 7.0,
   "speaker": "speaker_1",
   "words": [
    15,
    15
   ]
  },
  {
   "id": 4,
   "text": "నా అసిస్టెంట్స్ ఏదో పెద్దగా కాపాడేటట్టు \"వెళ్ళిపోదాం సార్ అక్కడికి టక్ టక్ అని ఫాస్ట్ గా వెళ్ళిపోదాం\" అన్నారు.",
   "start": 7.14,
   "end": 13.08,
   "speaker": "speaker_0",
   "words": [
    16,
    30
   ]
  },
  {
   "id": 5,
   "text": "వద్దురా ఇంతమంది ఉన్నారు ఎలా వెళ్ళిపోతుంది.",
   "start": 13.28,
   "end": 15.86,
   "speaker": "speaker_0",
   "words": [
    31,
    35
   ]
  },
  {
   "id": 6,
   "text": "\"లేదు సార్ మేమున్నాం\" అన్నారు.",
   "start": 15.9,
   "end": 16.98,
   "speaker": "speaker_0",
   "words": [
    36,
    39
   ]
  },
  {
   "id": 7,
   "text": "అప్పుడు నా అసిస్టెంట్ కూడా ఇంత మిస్ అలా ఉండేది ఆయనకి.",
   "start": 17.26,
   "end": 19.84,
   "speaker": "speaker_0",
   "words": [
    40,
    48
   ]
  },
  {
   "id": 8,
   "text": "ఓకే",
   "start": 19.92,
   "end": 20.08,
   "speaker": "speaker_1",
   "words": [
    49,
    49
   ]
  },
  {
   "id": 9,
   "text": "\"అన్న వెళ్ళిపోదాం అన్న\" అన్న.",
   "start": 20.24,
   "end": 21.62,
   "speaker": "speaker_0",
   "words": [
    50,
    53
   ]
  },
  {
   "id": 10,
   "text": "సరే నేను కూడా కొంచెం ఇది అయిపోయి సరే వెళ్దాం అని వెళ్ళిపోయాను.",
   "start": 22.3,
   "end": 25.68,
   "speaker": "speaker_0",
   "words": [
    54,
    63
   ]
  },
  {
   "id": 11,
   "text": "సగంలోనే వాళ్ళు ఎక్కడున్నారో తెలీదు.",
   "start": 25.96,
   "end": 27.78,
   "speaker": "speaker_0",
   "words": [
    64,
    67
   ]
  },
  {
   "id": 12,
   "text": "అయ్యో",
   "start": 27.9,
   "end": 28.2,
   "speaker": "speaker_1",
   "words": [
    68,
    68
   ]
  },
  {
   "id": 13,
   "text": "అక్కడ చూస్తే వాడే నన్నా నన్నా నన్నా అంటున్నాడు అక్కడక్కడా దూరంలో అలా ఉన్నాడు.",
   "start": 28.82,
   "end": 32.7,
   "speaker": "speaker_0",
   "words": [
    69,
    79
   ]
  },
  {
   "id": 14,
   "text": "నేను అలా గిలా అలా కుట్టుకొని కార్ లోకి వచ్చేసాను నేను.",
   "start": 33.36,
   "end": 35.92,
   "speaker": "speaker_0",
   "words": [
    80,
    88
   ]
  },
  {
   "id": 15,
   "text": "ఉమ్",
   "start": 35.96,
   "end": 36.1,
   "speaker": "speaker_1",
   "words": [
    89,
    89
   ]
  },
  {
   "id": 16,
   "text": "టక్ అని ఈట్ సైడ్ ఒక పదిహేను మంది ఈట్ సైడ్ ఒక పది మంది పట్టేసి, పట్టేసి చేతులు పెట్టేశారు.",
   "start": 36.52,
   "end": 40.32,
   "speaker": "speaker_0",
   "words": [
    90,
    105
   ]
  },
  {
   "id": 17,
   "text": "ఇది లవ్ వాళ్ళకి బట్ నాకు హర్ట్ అవుతుంది.",
   "start": 40.46,
   "end": 42.58,
   "speaker": "speaker_0",
   "words": [
    106,
    112
   ]
  },
  {
   "id": 18,
   "text": "లాగుతున్నారు ఈట్ సైడ్ లాగుతున్నారు.",
   "start": 42.66,
   "end": 44.16,
   "speaker": "speaker_0",
   "words": [
    113,
    116
   ]
  },
  {
   "id": 19,
   "text": "శక్తి ఎంత చేసి లాగి చెయ్యి వదుల్చుకొని తీరా కార్ అని చెప్పాను.",
   "start": 44.48,
   "end": 49.22,
   "speaker": "speaker_0",
   "words": [
    117,
    126
   ]
  },
  {
   "id": 20,
   "text": "ఆ తర్వాత ఒక హాఫ్ ఎన్ అవర్ తర్వాత వస్తున్నారు నా అసిస్టెంట్స్.",
   "start": 49.84,
   "end": 52.46,
   "speaker": "speaker_0",
   "words": [
    127,
    136
   ]
  },
  {
   "id": 21,
   "text": "పాపం",
   "start": 52.52,
   "end": 53.3,
   "speaker": "speaker_1",
   "words": [
    137,
    137
   ]
  },
  {
   "id": 22,
   "text": "వాళ్ళ ప్రేమ ఒక్కొక్కసారి కొంచెం ఇబ్బంది అవుతుంది.",
   "start": 53.34,
   "end": 55.84,
   "speaker": "speaker_0",
   "words": [
    138,
    143
   ]
  },
  {
   "id": 23,
   "text": "బట్ ఇట్స్ పార్ట్ ఆఫ్ యాక్టర్స్ లైఫ్.",
   "start": 56.54,
   "end": 58.44,
   "speaker": "speaker_0",
   "words": [
    144,
    149
   ]
  }
